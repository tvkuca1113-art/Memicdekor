# Kopirajte u .env.local (lokalno) ili upišite u postavke hostinga (npr. Vercel → Environment Variables).

# Javna adresa stranice (canonical, sitemap, Open Graph, JSON-LD). Bez završne kose crte.
SITE_URL=https://memic.ba

# Indeksiranje u pretraživačima. Postavite na "true" SAMO za produkcijsku objavu.
# Bez ove vrijednosti stranica šalje noindex (meta, X-Robots-Tag, robots.txt Disallow).
# Na Vercelu se preview/development verzije nikad ne indeksiraju, bez obzira na ovu vrijednost.
SITE_INDEXABLE=

# Slanje forme za upit preko Resend API-ja (https://resend.com).
# Bez ključa i pošiljaoca forma jasno javlja da poruka nije poslana i nudi e-mail i telefon.
RESEND_API_KEY=
# Pošiljalac mora biti na domeni verifikovanoj u Resendu, npr. "Web upit <upit@memic.ba>".
CONTACT_FROM_EMAIL=
# Primalac upita (zadano: info@memic.ba).
CONTACT_TO_EMAIL=info@memic.ba
