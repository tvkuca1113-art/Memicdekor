# Kopirajte u .env.local (lokalno) ili upišite u Vercel → Settings → Environment Variables.
# Uputstvo za Vercel: docs/VERCEL.md

# Javna adresa stranice (canonical, sitemap, Open Graph, JSON-LD). Bez završne kose crte.
# Na Vercelu postavite samo za Production, kada memic.ba pokazuje na Vercel.
# Bez nje: na Vercelu se koristi domena projekta (ili adresa preview grane), lokalno https://memic.ba.
SITE_URL=https://memic.ba

# Indeksiranje u pretraživačima. Postavite na "true" SAMO za produkciju, kao posljednji korak objave.
# Bez ove vrijednosti stranica šalje noindex (meta, X-Robots-Tag, robots.txt Disallow).
# Na Vercelu se preview/development verzije nikad ne indeksiraju, a na produkciji samo kanonska domena.
SITE_INDEXABLE=

# Slanje forme za upit preko Resend API-ja (https://resend.com).
# Bez ključa i pošiljaoca forma jasno javlja da poruka nije poslana i nudi e-mail i telefon.
RESEND_API_KEY=
# Pošiljalac mora biti na domeni verifikovanoj u Resendu, npr. "Web upit <upit@memic.ba>".
CONTACT_FROM_EMAIL=
# Primalac upita (zadano: info@memic.ba).
CONTACT_TO_EMAIL=info@memic.ba
